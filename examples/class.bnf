// A variable non-terminal can hold any Python object, not just a string.
// $CLASS creates an instance of a class defined in the pre block and
// $INSTANCE calls a method on that same instance through a back reference.
//
// usage: nelly -c 5 examples/class.bnf

include "constants.bnf"

<%pre
    class Nelly:
        def __init__(self, sData='default'):
            self.sData = sData

        def __str__(self):
            return 'Class Nelly: <%s>' % self.sData

        def some_function(self, append):
            return self.sData.lower() + ' ' + append
%>

START(start)
    : %str($CLASS) SP $INSTANCE
    ;

$CLASS
    : RANDOM <% $* = Nelly($$) %>
    ;

$INSTANCE
    : \$CLASS <% $* = $$.some_function('Append') %>
    ;

RANDOM
    : ("A"|"B"|"C"){5,10}
    ;

<%post
    print($$)
%>


// Back references, function calls and variable non-terminals: the same
// random INPUT is base64 encoded two different ways.
//
// usage: nelly -c 5 examples/base64.bnf

include "constants.bnf"

<%pre
    import base64
    nelly.encode = 'utf-8'
%>

DEMO(start):
    INPUT LF
    B1    LF
    $B2
    ;

B1: %base64.b64encode(\INPUT);

$B2: \INPUT <% $* = base64.b64encode($$) %>;

INPUT: ("A"|"a"){5,10};

<%post
    print($$.decode('ascii'))
%>

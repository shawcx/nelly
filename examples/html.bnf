// Writing each result to its own file. Reading $out in the pre block makes
// nelly stop with an error if -v out=... was not given.
//
// usage: nelly -c 5 -v out=/tmp/html examples/html.bnf

include "constants.bnf"

<%pre
    import base64
    import html
    $out
%>

HTML_START(start)
    : "<html>" CRLF HEAD CRLF BODYTAG CRLF "</html>" CRLF
    ;

HEAD
    : "<head>" CRLF "<title>" $TITLE "</title>" CRLF "</head>"
    ;

$TITLE
    : RANDCHAR{5,10} <% $* = html.escape($$) %>
    ;

BODYTAG
    : "<body>" CRLF BODY CRLF "</body>"
    ;

BODY
    : WORD ' => ' $ENCODER SP %str(%len(\WORD)) ' bytes'
    ;

$ENCODER
    : \WORD <% $* = base64.b64encode($$.encode('utf-8')).decode('ascii') %>
    ;

<%post
    os.makedirs($out, exist_ok=True)
    path = os.path.join($out, 'test-%.4d.html' % $count)
    with open(path, 'w') as fp:
        fp.write($$)
    print(path)
%>
